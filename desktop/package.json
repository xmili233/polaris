{
  "name": "polaris-desktop",
  "license": "AGPL-3.0-only",
  "productName": "Polaris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && pnpm run build:service && vite build",
    "build:service": "node scripts/build-service.mjs",
    "package": "node scripts/package.mjs",
    "start": "electron .",
    "pretest": "pnpm run build:service",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "test:ui": "node tests/desktop.e2e.mjs",
    "test:animation": "node tests/animation.e2e.mjs",
    "test:agent": "node tests/native-agent.e2e.mjs",
    "test:onboarding": "node tests/onboarding.e2e.mjs",
    "test:i18n": "node tests/i18n.e2e.mjs",
    "test:execution": "node tests/execution.e2e.mjs",
    "test:knowledge": "node tests/knowledge.e2e.mjs",
    "test:schedule": "node tests/schedule.e2e.mjs",
    "test:work-agents": "node tests/work-agents.e2e.mjs",
    "test:cards": "node tests/cards.e2e.mjs",
    "test:models": "node tests/agent-model-selector.e2e.mjs",
    "test:appearance": "node tests/appearance.e2e.mjs",
    "test:ci": "pnpm test:ui && pnpm test:cards && pnpm test:work-agents && pnpm test:schedule && pnpm test:execution && pnpm test:i18n && pnpm test:agent && pnpm test:onboarding && pnpm test:knowledge && pnpm test:models && pnpm test:appearance"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.99.1",
    "@assistant-ui/react": "0.15.32",
    "@polaris/i18n": "workspace:*",
    "croner": "11.0.0",
    "lucide-react": "1.67.0",
    "open-bot-avatar": "0.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.11",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.1.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
