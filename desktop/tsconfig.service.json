{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ESNext.Intl"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": "dist-service",
    "rootDir": "service",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "service"
  ]
}
